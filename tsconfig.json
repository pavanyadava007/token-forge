{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "lib",
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "stories",
    "tests",
    ".storybook"
  ]
}