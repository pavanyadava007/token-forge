{
  "name": "token-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design tokens -> CSS variables + Tailwind v4 theme, Lit web components, token-release automation and a measured LLM token-migration agent.",
  "license": "MIT",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/validate-tokens.mjs",
    "tokens:diff": "node scripts/token-diff.mjs",
    "build": "npm run tokens && tsc -p tsconfig.json --noEmit && vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build -o storybook-static --quiet",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,css}\" \"stories/**/*.ts\" \"scripts/**/*.mjs\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"stories/**/*.ts\" \"scripts/**/*.mjs\" \"tests/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@storybook/web-components-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "lit": "^3.3.3",
    "prettier": "^3.9.9",
    "storybook": "^10.6.1",
    "style-dictionary": "^5.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
